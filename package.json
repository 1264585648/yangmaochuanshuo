{
  "name": "dealdex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DealDex 数字福利抽卡大厅",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run coverage && npm run build",
    "typecheck": "wrangler types && tsc -p worker",
    "dev:api": "vite build && wrangler dev --port 8787",
    "dev:remote": "vite build && wrangler dev --port 8787 --remote",
    "db:migrate:local": "wrangler d1 migrations apply dealdex --local",
    "db:migrate:remote": "wrangler d1 migrations apply dealdex --remote",
    "db:seed:local": "node scripts/seed-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
